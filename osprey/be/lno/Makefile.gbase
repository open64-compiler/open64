ifeq ($(BUILD_TARGET), X8664)
BE_LNOPT_CXX_SRCS += simd.cxx
BE_LNOPT_CXX_SRCS += simd_util.cxx
endif

ifeq ($(BUILD_PCH), USE_PCH)
LNOPT_PCH_OBJS = $(BE_LNOPT_CXX_SRCS:.cxx=.o)
LNOPT_CXX_SRCS = $(BE_COM_CXX_SRCS) 
else
LNOPT_CXX_SRCS = $(BE_COM_CXX_SRCS) $(BE_LNOPT_CXX_SRCS)
endif

BE_REGION_CXX_SRCS = \
  rail.cxx			\
  rbi.cxx			\

LNOPT_SRCS = \
  $(BE_LNOPT_SRCS)		\

LNOPT_OBJS = $(LNOPT_SRCS:.c=.o)
LNOPT_CXX_OBJS = $(LNOPT_CXX_SRCS:.cxx=.o)

LNOPT_DSOS = $(WOPT_SO) $(BE_SO) $(IPL_SO)

# extra files to be removed with make clobber
LDIRT = ii_files *.pch

VPATH    =  $(SRC_DIRS)

# Share only detached VHO planning, never native materialization, with LNO.
tensor_schedule.o: $(BE_DIR)/vho/tensor_schedule.cxx $(BE_DIR)/vho/tensor_kernel_lower.h $(BE_DIR)/vho/tensor_attention_pattern.inc
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@

# Detached value layout is shared by every observer/application translation
# unit. Keep incremental builds from mixing incompatible vector element ABIs.
dsl_high_observer.o dsl_high_observer_json.o dsl_high_observer_native.o \
  dsl_high_apply.o lnopt_main.o tensor_high_lower.o tensor_schedule.o \
  tensor_attention_chunk_select.o tensor_attention_search.o \
  tensor_attention_search_test.o dsl_high_search_test.o dsl_high_movement_test.o \
  dsl_high_reuse.o dsl_high_quantized.o dsl_high_snapshot_capture.o: \
  $(BE_DIR)/vho/tensor_kernel_lower.h $(COMMON_COM_DIR)/dsl_tensor_traits.h

dsl_high_snapshot_capture.o: $(BE_LNOPT_DIR)/tests/dsl_high_snapshot_native_test.inc
dsl_high_observer_native.o: $(BE_LNOPT_DIR)/tests/dsl_high_reuse_native_test.inc

# Owned snapshot/report layout crosses the native/observer boundary. Rebuild
# every consumer together; these records never enter a WHIRL image.
dsl_high_snapshot.o dsl_high_snapshot_capture.o dsl_high_reuse.o \
  dsl_high_observer.o dsl_high_observer_json.o dsl_high_observer_native.o \
  dsl_high_apply.o lnopt_main.o dsl_high_search_test.o: \
  $(BE_LNOPT_DIR)/dsl_high_snapshot.h $(BE_LNOPT_DIR)/dsl_high_reuse.h \
  $(BE_LNOPT_DIR)/dsl_high_observer.h

dsl_high_reuse.o: $(BE_LNOPT_DIR)/dsl_high_reuse.cxx $(BE_DIR)/vho/dsl_gemm_readiness.h

tensor_attention_chunk_select.o: $(BE_DIR)/vho/tensor_attention_chunk_select.cxx $(BE_DIR)/vho/tensor_kernel_lower.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@

tensor_attention_search.o: $(BE_DIR)/vho/tensor_attention_search.cxx $(BE_DIR)/vho/tensor_attention_search.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@

lnodriver.o lnopt_main.o: $(BE_LNOPT_DIR)/lnoptimizer.h

# Selected-only semantic construction is outside the detached search closure.
tensor_high_lower.o: $(BE_DIR)/vho/tensor_high_lower.cxx $(BE_DIR)/vho/tensor_high_selected.inc $(BE_DIR)/vho/tensor_high_quantized.inc $(BE_DIR)/vho/tensor_kernel_lower.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@

dsl_high_apply.o: $(BE_DIR)/vho/tensor_selected_key.h $(BUILD_TOT)/common/com/dsl_native_tree_key.h

# Standalone tests link only the detached service and read-only hardware records.
# The scripted clock cannot be selected in the production shared component.
dsl_high_search_test.o: $(BE_LNOPT_DIR)/tests/dsl_high_search_control_test.cxx $(BE_LNOPT_DIR)/dsl_high_observer.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@

tensor_attention_search_test.o: $(BE_DIR)/vho/tensor_attention_search.cxx $(BE_DIR)/vho/tensor_attention_search.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) -DVHO_MLA_SEARCH_TEST_CLOCK $< -o $@

dsl_high_search_hardware.o: $(COMMON_TARG_INFO_ACCESS_DIR)/dsl_memory_hierarchy.cxx
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@

dsl_high_search_control_test: dsl_high_search_test.o tensor_attention_search_test.o dsl_high_search_hardware.o dsl_high_observer.o dsl_high_observer_json.o dsl_high_snapshot.o tensor_schedule.o tensor_attention_chunk_select.o
	$(link.c++f) -o $@ $^

LCOPTS = $(STD_COMPILE_OPTS) $(STD_C_OPTS)
LCDEFS = $(HOSTDEFS) $(TARGDEFS)
LCINCS = $(addprefix -I, $(HEADER_DIRS))
ifeq ($(BUILD_OS), LINUX)
LCINCS += -I$(BUILD_AREA)/include
endif

LC++OPTS = $(STD_COMPILE_OPTS) $(STD_C++_OPTS) $(PCH_OPTS)
LC++DEFS = $(HOSTDEFS) $(TARGDEFS)
LC++INCS = $(addprefix -I, $(HEADER_DIRS))

LASDEFS = $(HOSTDEFS) $(TARGDEFS)
LASINCS = $(addprefix -I, $(HEADER_DIRS))
LASOPTS = $(STD_COMPILE_OPTS)

# setup stuff to build shared or non-shared
GLDOPTS = $(STD_LOAD_OPTS) $(LD_QUICKSTART_INFO)

DSOSTARTOPT = -check_registry $(TARG_BE)/so_locations -Wl,-no_unresolved
DSOSTARTOPT_32 = $(DSOSTARTOPT)
DSOSTARTOPT_N32 = $(DSOSTARTOPT)

ifeq ($(BUILD_VARIANT), MEM_STATS)
LLDLIBS +=  -lmalloc
LDFLAGS += -lmalloc
endif
LLDLIBS += $(TARG_TARG_INFO)/libtarginfo.a

#----------------------------------------------------------------------
# File containing the list of symbols exported outside of cg.so
#----------------------------------------------------------------------
EXPORT_LIST =

#----------------------------------------------------------------------
#  Define target
#----------------------------------------------------------------------

ifdef LINK_DSO
TARGETS = debug-lno
else
 ifeq ($(BUILD_TYPE), NONSHARED)
TARGETS = liblno.a
 else
TARGETS = $(LNO_SO)
 endif
endif

.PHONY: default	first last install
#----------------------------------------------------------------------
#  Variables describing additional sources, objects, and libraries
#----------------------------------------------------------------------

default:
	$(MAKE) first
	$(MAKE) $(TARGETS)
	$(MAKE) last

#----------------------------------------------------------------------
#  The commands in this section are done BEFORE any other target is
#  built.  If we are making default or install, we first make wopt.so,
#  which makes be.so; otherwise, we just make the specifically
#  requested target.
#----------------------------------------------------------------------
first:
ifndef SKIP_DEP_BUILD
## verify that wopt.so is up to date
	$(call submake,$(TARG_OPT_DIR))
## verify that ipl.so if up to date
	$(call submake,$(TARG_IPL_DIR))
 ifeq ($(BUILD_PCH), USE_PCH)
## build pch files first so that we can use precompiled headers
	( $(MAKE) $(.MAKEFLAGS) BUILD_PCH=USE_PCH PCH_OPTS="-LANG:create_pch=lno_pch.pch" lno_pch.pch lno_pch.o )
	( $(MAKE) $(.MAKEFLAGS) BUILD_PCH=USE_PCH PCH_OPTS="-LANG:use_pch=lno_pch.pch" lno_pch_files )
 endif
endif

#----------------------------------------------------------------------
#  The commands in this section are done AFTER every other target is
#  built.
#----------------------------------------------------------------------
last: make_deps

#----------------------------------------------------------------------
#  Build 'lnopt'
#
#  These rules build the 'lnopt' executable by default, and can install
#  it in the $(BUILD_INSTALL)/usr/lib directory.
#
#----------------------------------------------------------------------


install:: default
ifeq ($(BUILD_OS), LINUX)
	$(STD_INSTALL) $(STD_INSTALL_EXEC_MASK) -D $(TARGETS) $(STD_MONGOOSE_LINUX_LOC)/$(TARGETS)
else
	$(STD_INSTALL) $(STD_INSTALL_EXEC_MASK) -F $(STD_MONGOOSE_LOC) $(LNO_SO)
 ifeq ($(BUILD_TYPE), SHARED)
 ifndef NOSYSGEN
	$(STD_INSTALL) $(STD_INSTALL_EXEC_MASK) -F /usr/cpu/sysgen/root$(STD_MONGOOSE_LOC) $(LNO_SO)
 endif
 endif
endif

ifeq ($(BUILD_PCH), USE_PCH)

lno_pch_files: $(LNOPT_PCH_OBJS) lno_pch.pch

$(LNO_SO):  $(LNOPT_OBJS) $(LNOPT_CXX_OBJS) $(LNOPT_PCH_OBJS) \
         $(LNOPT_DSOS) $(BE_LNOPT_DIR)/Exported $(BE_BE_DIR)/so_locations
	$(link.c++f) -o $(LNO_SO) $(STD_DSO_LOADOPTS) $(EXPORT_LIST) \
         $(LNOPT_OBJS) $(LNOPT_CXX_OBJS) $(LNOPT_PCH_OBJS) \
         $(LNOPT_DSOS) $(LLDLIBS) -show
	if [ ! -l $(BE_SO) ]; then ln -sf $(TARG_BE_DIR)/$(BE_SO) .; fi
	if [ ! -l $(WOPT_SO) ]; then ln -sf $(TARG_OPT_DIR)/$(WOPT_SO) .; fi
	if [ ! -l $(IPL_SO) ]; then ln -sf $(TARG_IPL_DIR)/$(IPL_SO) .; fi
	if [ ! -l be ]; then ln -sf $(TARG_BE)/be .; fi
	if [ ! -l lnopt ]; then ln -sf $(TARG_BE)/be lnopt; fi

else

$(LNO_SO):	$(LNOPT_OBJS) $(LNOPT_CXX_OBJS) $(BE_LNOPT_DIR)/Exported \
	$(LNOPT_DSOS) $(BE_BE_DIR)/so_locations $(TARG_TARG_INFO)/libtarginfo.a
	$(link.c++f) -o $(LNO_SO) $(STD_DSO_LOADOPTS) $(EXPORT_LIST) \
	$(LNOPT_OBJS) $(LNOPT_CXX_OBJS) $(LNOPT_DSOS) $(LLDLIBS)

$(WOPT_SO):
	if ! test -e $(WOPT_SO); then ln -sf $(TARG_OPT_DIR)/$(WOPT_SO) .; fi

$(BE_SO):
	if ! test -e $(BE_SO); then ln -sf $(TARG_BE_DIR)/$(BE_SO) .; fi

$(IPL_SO):
	if ! test -e $(IPL_SO); then ln -sf $(TARG_IPL_DIR)/$(IPL_SO) .; fi

liblno.a: $(LNOPT_CXX_OBJS) $(LNOPT_OBJS)
	$(ar) cru $@ $^

endif

LDIRT += $(BE_SO) $(WOPT_SO) $(IPL_SO) be bedriver lnopt


ifdef LINK_DSO
LINK_DSO_OPTS += -L .

debug-lno: $(LNO_SO)
	rm -f ../be/bedriver ../be/be
	(cd $(TARG_BE); $(MAKE) BE_OPT_DIR='$(BE_OPT_DIR)' \
                                     LINK_DSO='$(LINK_DSO)' \
                                     LINK_DSO_OPTS='$(LINK_DSO_OPTS) -L.' \
                                 be)
endif

#----------------------------------------------------------------------
#  Include the usual commonrules
#----------------------------------------------------------------------
include $(COMMONRULES)

#----------------------------------------------------------------------
#  Special case rules for files that want to be individualistic
#----------------------------------------------------------------------

DSONAMEOPT =


# MR2 changes only detached DTOs. Rebuild every consumer of their value layout.
dsl_high_observer.o dsl_high_observer_json.o dsl_high_observer_native.o \
  dsl_high_apply.o lnopt_main.o dsl_high_reuse.o dsl_high_search_test.o \
  tensor_attention_search.o tensor_attention_search_test.o: \
  $(BE_DIR)/vho/tensor_attention_search.h $(BE_DIR)/vho/tensor_attention_movement.h

tensor_attention_search.o tensor_attention_search_test.o: $(BE_DIR)/vho/tensor_attention_movement.inc

dsl_high_search_control_test: dsl_high_reuse.o

dsl_high_movement_test.o: $(BE_LNOPT_DIR)/tests/dsl_high_movement_test.cxx $(BE_LNOPT_DIR)/dsl_high_observer.h $(BE_DIR)/vho/tensor_attention_movement.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@

dsl_high_movement_test: dsl_high_movement_test.o tensor_attention_search_test.o dsl_high_search_hardware.o dsl_high_observer.o dsl_high_observer_json.o dsl_high_snapshot.o dsl_high_reuse.o tensor_schedule.o tensor_attention_chunk_select.o
	$(link.c++f) -o $@ $^

dsl_high_quantized.o: $(BE_LNOPT_DIR)/dsl_high_quantized.cxx $(BE_LNOPT_DIR)/dsl_high_quantized.h $(COMMON_COM_DIR)/dsl_native_tree_key.h

tensor_q1_program.o: $(BE_DIR)/vho/tensor_q1_program.cxx $(BE_DIR)/vho/tensor_q1_program.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@
lnodriver.o dsl_q1_preopt.o: $(BE_LNOPT_DIR)/dsl_q1_preopt.h

dsl_q1_preopt.o dsl_high_quantized.o: $(BE_LNOPT_DIR)/dsl_high_quantized.h $(BE_DIR)/vho/tensor_q1_program.h

# Q2 owned workload layout is shared across native consumers.
tensor_workload.o: $(BE_DIR)/vho/tensor_workload.cxx $(BE_DIR)/vho/tensor_workload.h $(BE_DIR)/vho/tensor_kernel_lower.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@
tensor_high_lower.o tensor_q1_program.o dsl_high_quantized.o dsl_q1_preopt.o lnodriver.o: $(BE_DIR)/vho/tensor_workload.h

tensor_serving_schema.o: $(BE_DIR)/vho/tensor_serving_schema.cxx $(BE_DIR)/vho/tensor_serving_schema.h $(BE_DIR)/vho/tensor_workload.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@
tensor_high_lower.o tensor_q1_program.o: $(BE_DIR)/vho/tensor_serving_schema.h

# Q4 detached model and live-export adapter dependencies.
tensor_attention_search.o tensor_attention_search_test.o: $(BE_DIR)/vho/tensor_quantized_movement.h $(BE_DIR)/vho/tensor_quantized_movement.inc $(BE_DIR)/vho/tensor_serving.h

dsl_high_quantized_movement_test.o: $(BE_LNOPT_DIR)/tests/dsl_high_quantized_movement_test.cxx $(BE_DIR)/vho/tensor_quantized_movement.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) -std=c++98 -O0 $< -o $@
dsl_high_quantized_movement_test: dsl_high_quantized_movement_test.o tensor_attention_search_test.o dsl_high_search_hardware.o dsl_high_observer.o dsl_high_observer_json.o dsl_high_snapshot.o dsl_high_reuse.o tensor_schedule.o tensor_attention_chunk_select.o
	$(link.c++f) -o $@ $^
LDIRT += dsl_high_quantized_movement_test.o dsl_high_quantized_movement_test

# Q4 adds detached report fields; all value-layout consumers rebuild together.
dsl_high_movement_test.o dsl_high_quantized_movement_test.o \
  dsl_high_observer.o dsl_high_observer_json.o dsl_high_observer_native.o \
  dsl_high_apply.o lnopt_main.o dsl_high_reuse.o dsl_high_search_test.o \
  tensor_attention_search.o tensor_attention_search_test.o: \
  $(BE_DIR)/vho/tensor_quantized_movement.h $(BE_DIR)/vho/tensor_serving.h $(BE_DIR)/vho/tensor_serving_schema.h

# Q5 strict selected plan qualification/materialization.
tensor_serving_schema.o: $(BE_DIR)/vho/tensor_quantized_plan.h $(BE_DIR)/vho/tensor_quantized_plan.inc
tensor_high_lower.o: $(BE_DIR)/vho/tensor_quantized_plan.h $(BE_DIR)/vho/tensor_high_q5.inc
tensor_q1_program.o dsl_q1_preopt.o: $(BE_DIR)/vho/tensor_quantized_plan.h
tensor_attention_search.o: $(BE_DIR)/vho/tensor_quantized_plan.h $(BE_DIR)/vho/tensor_q5_cost.inc
tensor_attention_search_test.o: $(BE_DIR)/vho/tensor_q5_cost.inc
tensor_high_lower.o: $(BE_DIR)/vho/tensor_high_selected.inc

# Complete Q5 source qualification remains detached in standalone cost tests.
dsl_high_search_control_test dsl_high_movement_test dsl_high_quantized_movement_test: tensor_serving_schema.o tensor_workload.o
tensor_high_lower.o: $(BE_DIR)/vho/tensor_high_quantized.inc

# H1c consumer oracle reuses detached production services; imported evidence is
# owned input. The importer/hash objects are test-only, not added to lno.so.
dsl_high_device_test.o: $(BE_LNOPT_DIR)/tests/dsl_high_device_test.cxx $(BE_DIR)/com/dsl_gpu_plan.h $(BE_LNOPT_DIR)/dsl_high_binding_keys.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@

dsl_high_device_import_test.o: $(BE_DIR)/com/dsl_gpu_profile.cxx $(BE_DIR)/com/dsl_gpu_profile.h $(COMMON_TARG_INFO_ACCESS_DIR)/dsl_device_profile.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) -I$(BE_DIR)/vho -I$(BUILD_TOT) $< -o $@

dsl_high_device_sha_test.o: $(BE_DIR)/vho/fhe_sha256.cxx $(BE_DIR)/vho/fhe_sha256.h
	$(cxx) -c $(CPPFLAGS) $(CXXFLAGS) $< -o $@

dsl_high_device_test: tensor_serving_schema.o tensor_workload.o dsl_high_device_test.o dsl_high_device_import_test.o dsl_high_device_sha_test.o tensor_attention_search_test.o dsl_high_search_hardware.o dsl_high_observer.o dsl_high_observer_json.o dsl_high_snapshot.o dsl_high_reuse.o tensor_schedule.o tensor_attention_chunk_select.o
	$(link.c++f) -o $@ $^

LDIRT += dsl_high_device_test dsl_high_device_test.o dsl_high_device_import_test.o dsl_high_device_sha_test.o

# H2 owned movement source projections; existing phase/library boundaries.

dsl_high_movement.o: $(BE_LNOPT_DIR)/dsl_high_movement.cxx $(BE_LNOPT_DIR)/dsl_high_movement.h $(BE_DIR)/com/dsl_movement_facts.h
dsl_high_observer.o dsl_high_observer_native.o dsl_high_apply.o dsl_high_device_test.o dsl_high_observer_json.o: $(BE_LNOPT_DIR)/dsl_high_observer.h $(BE_LNOPT_DIR)/dsl_high_movement.h

# H2 reverse generated-header dependency closure.
dsl_high_apply.o dsl_high_device_test.o dsl_high_movement_test.o dsl_high_observer.o dsl_high_observer_json.o dsl_high_observer_native.o dsl_high_quantized_movement_test.o dsl_high_search_test.o lnopt_main.o: $(BUILD_TOT)/be/lno/dsl_high_observer.h

# H2 reverse generated-header dependency closure.
dsl_high_apply.o dsl_high_quantized.o dsl_q1_preopt.o: $(BUILD_TOT)/common/com/dsl_native_tree_key.h

# H2 complete owned-record consumer closure, including runtime sidecars.
dsl_high_apply.o dsl_high_device_test.o dsl_high_movement.o dsl_high_movement_test.o \
dsl_high_observer.o dsl_high_observer_json.o dsl_high_observer_native.o dsl_high_quantized_movement_test.o \
dsl_high_search_test.o lnopt_main.o tensor_attention_search.o tensor_attention_search_test.o: $(BUILD_TOT)/be/com/dsl_movement_facts.h
