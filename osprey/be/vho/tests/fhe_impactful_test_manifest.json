{
  "schema_version": 1,
  "lanes": {
    "hygiene": {
      "status": "automated",
      "command": "git diff --check"
    },
    "selector-self-test": {
      "status": "automated",
      "command": "python3 osprey/be/vho/tests/fhe_impactful_test_selector_test.py"
    },
    "tail-plan": {
      "status": "automated",
      "command": "sh osprey/be/vho/tests/fhe_ckks_tail_plan_test.sh /private/tmp/open64-fhe-impactful/tail"
    },
    "relu-recipe": {
      "status": "automated",
      "command": "sh osprey/be/vho/tests/fhe_ckks_relu_recipe_test.sh /private/tmp/open64-fhe-impactful/relu-recipe"
    },
    "relu-event-plan": {
      "status": "automated",
      "command": "sh osprey/be/vho/tests/fhe_ckks_relu_event_plan_test.sh /private/tmp/open64-fhe-impactful/relu-event"
    },
    "expand-state": {
      "status": "automated",
      "command": "sh osprey/be/vho/tests/fhe_ckks_expand_state_test.sh /private/tmp/open64-fhe-impactful/expand-state"
    },
    "ckks2c-emitter": {
      "status": "automated",
      "command": "bash osprey/be/vho/tests/fhe_ckks2c_emit_test.sh /private/tmp/open64-fhe-impactful/ckks2c-emitter"
    },
    "ckks2c-collector": {
      "status": "automated",
      "command": "bash osprey/be/vho/tests/fhe_ckks2c_collect_test.sh /private/tmp/open64-fhe-impactful/ckks2c-collector"
    },
    "ckks2c-cached-image": {
      "status": "environment",
      "command": "bash osprey/be/vho/tests/fhe_ckks2c_cached_image_test.sh <output-dir> <cached-secure_resnet20.ckks_ops.B> <linked-collector>"
    },
    "ckks2c-checkpoint": {
      "status": "automated",
      "command": "bash osprey/be/vho/tests/fhe_ckks2c_checkpoint_test.sh /private/tmp/open64-fhe-impactful/ckks2c-checkpoint"
    },
    "fhe-semantic-conversion": {
      "status": "environment",
      "command": "rebuild and run the linked ir_tools fhe_semantic_convert_test"
    },
    "ckks2c-group-join": {
      "status": "automated",
      "command": "bash osprey/be/vho/tests/fhe_ckks2c_group_join_test.sh /private/tmp/open64-fhe-impactful/ckks2c-group-join"
    },
    "ckks2c-group-lowering": {
      "status": "environment",
      "command": "rebuild linked fhe_runtime_lower_contract_test and be; run the receipt-matched cached S6-0c .B through -FHE:checkpoint and reopen with ir_b2a -st -src"
    },
    "ckks2c-driver-exit": {
      "status": "planned",
      "command": "sh osprey/driver/tests/openpy_fhe_ckks2c_exit_test.sh /private/tmp/open64-fhe-impactful/ckks2c-driver"
    },
    "ckks2c-route-option": {
      "status": "environment",
      "command": "bash osprey/be/vho/tests/fhe_codegen_route_option_test.sh with rebuilt OPEN64_DSL_CONTRACT_TEST, OPEN64_BE, OPEN64_BE_LIBRARY_DIR, OPEN64_IR_B2A, OPEN64_OPENPY, and host-mounted OPEN64_FHE_CODEGEN_OPTION_ARTIFACT_DIR"
    },
    "ckks2c-ant-admission": {
      "status": "environment",
      "command": "bash osprey/libopen64fhe/tests/fhe_ace_ant_admission_test.sh <pinned-ace-root> /private/tmp/open64-fhe-impactful/ckks2c-ant"
    },
    "s6-0d-closure": {
      "status": "environment",
      "command": "bash osprey/libopen64fhe/tests/fhe_sync6_s6_0d_closure_test.sh <output-dir> <d4-receipt-dir> <d5-route-dir> <pinned-ace-root>"
    },
    "full-s6-0d-certification": {
      "status": "manual-expensive",
      "command": "run content-addressed ResNet CKKS2C certification only after documented impact proof invalidates the matching receipt"
    },
    "common-ckks-transaction": {
      "status": "automated",
      "command": "sh osprey/common/com/tests/dsl_ckks_expand_transaction_test.sh"
    },
    "view-retirement": {
      "status": "automated",
      "command": "sh osprey/common/com/tests/dsl_view_retirement_test.sh"
    },
    "syntax-layout-matrix": {
      "status": "automated",
      "command": "sh osprey/common/com/tests/dsl_native_syntax_test.sh"
    },
    "backend-link-boundary": {
      "status": "environment",
      "command": "rebuild be.so, be, and lw_inline; check forbidden symbols"
    },
    "mapped-reopen": {
      "status": "environment",
      "command": "reopen the affected focused .B with rebuilt ir_b2a -st -src"
    },
    "artifact-audit": {
      "status": "environment",
      "command": "run the affected independent audit against a receipt-matched retained .T"
    },
    "complete-audit-format": {
      "status": "automated",
      "command": "python3 osprey/be/vho/tests/test_fhe_ckks_complete_checkpoint_audit.py"
    },
    "frontend-native-smoke": {
      "status": "environment",
      "command": "run the established torch2whirl native Docker smoke lane"
    },
    "miniature-checkpoint": {
      "status": "automated",
      "command": "bash osprey/be/vho/tests/fhe_ckks2c_checkpoint_test.sh /private/tmp/open64-fhe-impactful/ckks2c-checkpoint"
    },
    "full-s6-0c-certification": {
      "status": "manual-expensive",
      "command": "run the complete ten-PU ResNet materialization only at a justified boundary"
    }
  },
  "rules": [
    {
      "name": "documentation",
      "patterns": ["AGENTS.md", "doc/**", "**/*.md"],
      "lanes": ["hygiene"]
    },
    {
      "name": "impact-selector",
      "patterns": [
        "osprey/be/vho/tests/fhe_impactful_test_manifest.json",
        "osprey/be/vho/tests/fhe_impactful_test_selector.py",
        "osprey/be/vho/tests/fhe_impactful_test_selector_test.py"
      ],
      "lanes": ["hygiene", "selector-self-test"]
    },
    {
      "name": "artifact-auditor",
      "patterns": ["osprey/be/vho/tests/*audit.py"],
      "lanes": ["hygiene", "complete-audit-format", "artifact-audit"]
    },
    {
      "name": "tail-plan",
      "patterns": [
        "osprey/be/vho/fhe_ckks_tail_plan.*",
        "osprey/be/vho/tests/fhe_ckks_tail_plan_test.*"
      ],
      "lanes": ["hygiene", "tail-plan"]
    },
    {
      "name": "relu-planning",
      "patterns": [
        "osprey/be/vho/fhe_ckks_relu_plan.*",
        "osprey/be/vho/fhe_ckks_relu_recipe.*",
        "osprey/be/vho/fhe_ckks_relu_event_plan.*",
        "osprey/be/vho/tests/fhe_ckks_relu_*test.*",
        "osprey/be/vho/tests/fhe_ckks_source_events_test.*"
      ],
      "lanes": ["hygiene", "relu-recipe", "relu-event-plan"]
    },
    {
      "name": "ckks-state-transfer",
      "patterns": [
        "osprey/be/vho/fhe_ckks_expand.*",
        "osprey/be/vho/fhe_ckks_transfer.*",
        "osprey/be/vho/tests/fhe_ckks_expand_state_test.*"
      ],
      "lanes": ["hygiene", "expand-state", "common-ckks-transaction"]
    },
    {
      "name": "ckks2c-emitter",
      "patterns": [
        "osprey/be/vho/fhe_ckks2c_emit.*",
        "osprey/include/open64_fhe_ckks2c_facade.h",
        "osprey/be/vho/tests/fhe_ckks2c_emit_test.*",
        "osprey/be/vho/tests/fhe_ckks2c_facade_link_stub.c"
      ],
      "lanes": ["hygiene", "ckks2c-emitter"]
    },
    {
      "name": "ckks2c-collector",
      "patterns": [
        "osprey/be/vho/fhe_ckks2c_collect.*",
        "osprey/be/vho/tests/fhe_ckks2c_collect_test.*",
        "osprey/be/vho/tests/fhe_ckks2c_collect_image_test.*",
        "osprey/be/vho/tests/fhe_ckks2c_cached_image_test.*"
      ],
      "lanes": [
        "hygiene",
        "ckks2c-collector",
        "ckks2c-cached-image",
        "artifact-audit"
      ]
    },
    {
      "name": "ckks2c-checkpoint",
      "patterns": [
        "osprey/be/vho/fhe_ckks2c_checkpoint.*",
        "osprey/be/vho/fhe_ckks2c_publish.*",
        "osprey/be/vho/tests/fhe_ckks2c_checkpoint_test.*"
      ],
      "lanes": [
        "hygiene",
        "ckks2c-checkpoint",
        "miniature-checkpoint",
        "artifact-audit"
      ]
    },
    {
      "name": "fhe-semantic-conversion",
      "patterns": [
        "osprey/be/vho/fhe_semantic_convert.*"
      ],
      "lanes": [
        "hygiene",
        "fhe-semantic-conversion",
        "ckks2c-checkpoint",
        "miniature-checkpoint"
      ]
    },
    {
      "name": "ckks2c-group-join",
      "patterns": [
        "osprey/be/vho/fhe_ckks2c_group_join.*",
        "osprey/be/vho/fhe_ckks2c_public_join.*",
        "osprey/be/vho/tests/fhe_ckks2c_group_join_test.*",
        "osprey/be/vho/tests/fhe_ckks2c_public_join_test.*"
      ],
      "lanes": [
        "hygiene",
        "ckks2c-group-join",
        "ckks2c-cached-image",
        "artifact-audit"
      ]
    },
    {
      "name": "ckks2c-group-lowering",
      "patterns": [
        "osprey/be/vho/fhe_ckks2c_lower.*",
        "osprey/be/vho/fhe_semantic_runtime_lower.*",
        "osprey/be/vho/tests/fhe_runtime_lower_contract_test.*"
      ],
      "lanes": [
        "hygiene",
        "ckks2c-group-lowering",
        "ckks2c-group-join",
        "backend-link-boundary",
        "mapped-reopen",
        "artifact-audit"
      ]
    },
    {
      "name": "ckks2c-driver-exit",
      "patterns": [
        "osprey/driver/tests/openpy_fhe_ckks2c_exit_test.*"
      ],
      "lanes": ["hygiene", "ckks2c-driver-exit"]
    },
    {
      "name": "ckks2c-route-option",
      "patterns": [
        "osprey/common/com/config_fhe.*",
        "osprey/driver/OPTIONS",
        "osprey/be/vho/tests/fhe_codegen_route_option_test.sh",
        "osprey/be/vho/tests/fhe_convert_contract_test.cxx"
      ],
      "lanes": ["hygiene", "ckks2c-route-option", "backend-link-boundary"]
    },
    {
      "name": "ckks2c-ant-admission",
      "patterns": [
        "osprey/libopen64fhe/*ckks2c*",
        "osprey/libopen64fhe/tests/fhe_ace_ant_admission*"
      ],
      "lanes": ["hygiene", "ckks2c-ant-admission"]
    },
    {
      "name": "s6-0d-closure",
      "patterns": [
        "osprey/libopen64fhe/tests/fhe_sync6_s6_0d_closure_test.sh"
      ],
      "lanes": ["hygiene", "s6-0d-closure"]
    },
    {
      "name": "fhe-materializer",
      "patterns": [
        "osprey/be/vho/fhe_ckks_*materialize.*",
        "osprey/be/vho/fhe_ckks_conv_expand.*",
        "osprey/be/vho/fhe_ckks_conv_specialize.*",
        "osprey/be/vho/fhe_semantic_materialize.*"
      ],
      "lanes": [
        "hygiene",
        "tail-plan",
        "relu-event-plan",
        "expand-state",
        "backend-link-boundary",
        "miniature-checkpoint",
        "full-s6-0c-certification"
      ]
    },
    {
      "name": "common-native-transaction",
      "patterns": [
        "osprey/common/com/dsl_ir_rewrite.*",
        "osprey/common/com/dsl_ir_image.*",
        "osprey/common/com/dsl_ir_group_lower.*",
        "osprey/common/com/dsl_ir_lower.*",
        "osprey/common/com/dsl_shape.*",
        "osprey/common/com/dsl_builder.*",
        "osprey/common/fhe/fhe_plan.*",
        "osprey/common/com/tests/dsl_builder_contract_test.*",
        "osprey/common/com/tests/dsl_ckks_expand_transaction_test.*",
        "osprey/common/com/tests/dsl_ckks_complete_group_lowering_test.*",
        "osprey/common/com/tests/dsl_dead_native_constant_batch_test.*",
        "osprey/common/com/tests/dsl_view_retirement_test.*"
      ],
      "lanes": [
        "hygiene",
        "common-ckks-transaction",
        "view-retirement",
        "mapped-reopen",
        "miniature-checkpoint",
        "full-s6-0c-certification"
      ]
    },
    {
      "name": "logical-printer-reader",
      "patterns": [
        "osprey/common/com/dsl_ir_print.*",
        "osprey/ir_tools/**",
        "osprey/common/com/ir_*"
      ],
      "lanes": ["hygiene", "mapped-reopen", "artifact-audit"]
    },
    {
      "name": "build-link-wiring",
      "patterns": [
        "osprey/be/be/Makefile*",
        "osprey/be/vho/Makefile*",
        "osprey/torch2whirl/Makefile*"
      ],
      "lanes": ["hygiene", "backend-link-boundary"]
    },
    {
      "name": "fhe-backend-checkpoint-driver",
      "patterns": ["osprey/be/be/driver.cxx"],
      "lanes": [
        "hygiene",
        "backend-link-boundary",
        "ckks2c-checkpoint",
        "ckks2c-route-option",
        "miniature-checkpoint",
        "mapped-reopen"
      ]
    },
    {
      "name": "frontend-bridge",
      "patterns": ["osprey/torch2whirl/**"],
      "lanes": ["hygiene", "frontend-native-smoke"]
    },
    {
      "name": "native-syntax-dispatch",
      "patterns": ["osprey/common/com/tests/dsl_native_syntax_test.sh"],
      "lanes": ["hygiene", "syntax-layout-matrix"]
    }
  ],
  "unknown_file_lanes": [
    "hygiene",
    "syntax-layout-matrix",
    "miniature-checkpoint",
    "full-s6-0c-certification"
  ]
}
