# -*- Makefile -*-
#
# Copyright (C) 2026 Open64 Project
#

# Makefile.base for torch2whirl.
#
# torch2whirl is organized beside clang2whirl as a standalone source frontend.
# It is the first Python/PyTorch ingestion driver, but the native DSL builder
# boundary remains independent so another Python ingestion strategy can be
# adopted later without changing downstream WHIRL consumers.
#
# This makefile is intentionally portable.  Generated Open64 build directories
# include it after configure sets BUILD_BASE, but developers can also invoke it
# directly from this source directory on macOS or Linux.

CXX ?= c++
PYTHON ?= python3
RM ?= rm -f
INSTALL ?= install
MKDIR_P ?= mkdir -p

BUILD_BASE ?= $(CURDIR)
PREFIX ?= /usr/local
BINDIR ?= $(PREFIX)/bin

TORCH2WHIRL_CXX_STD ?= -std=c++17
TORCH2WHIRL_WARNINGS ?= -Wall -Wextra
TORCH2WHIRL_PYTHON ?= $(PYTHON)
TORCH2WHIRL_PYTHONPATH ?= $(if $(BUILD_AREA),$(PYTHON_BUILD_ROOT):)$(BUILD_BASE)/python
TORCH2WHIRL_DRIVER ?= $(CURDIR)/torch2whirl
TORCH2WHIRL_CPPFLAGS ?= \
  -I$(BUILD_BASE) \
  -DTORCH2WHIRL_PYTHON=\"$(TORCH2WHIRL_PYTHON)\" \
  -DTORCH2WHIRL_PYTHONPATH=\"$(TORCH2WHIRL_PYTHONPATH)\"
TORCH2WHIRL_CXXFLAGS ?= $(TORCH2WHIRL_CXX_STD) $(TORCH2WHIRL_WARNINGS)
TORCH2WHIRL_LDFLAGS ?=

OPEN64_SRC_ROOT ?= $(abspath $(BUILD_BASE)/../..)
PYTHON_BUILD_ROOT ?= $(if $(BUILD_AREA),$(BUILD_AREA)/python,$(BUILD_BASE)/python)
PYTHON_NATIVE_PACKAGE_DIR ?= $(PYTHON_BUILD_ROOT)/open64_dsc
PYTHON_INCLUDE ?= $(shell $(PYTHON) -c 'import sysconfig; print(sysconfig.get_paths()["include"])')
PYTHON_EXT_SUFFIX ?= $(shell $(PYTHON) -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX") or ".so")')
PYTHON_NATIVE_CPPFLAGS ?= \
  -DKEY \
  -DOSP_OPT \
  -DPATHSCALE_MERGE \
  -DPSC_TO_OPEN64 \
  -D__STDC_LIMIT_MACROS \
  -D_NEW_SYMTAB \
  -DTARG_X8664 \
  -D__MIPS_AND_IA64_ELF_H \
  -I$(PYTHON_INCLUDE) \
  -I$(BUILD_BASE)/python/native \
  -I$(OPEN64_SRC_ROOT)/osprey/linux/include \
  -I$(OPEN64_SRC_ROOT)/osprey/ir_tools \
  -I$(OPEN64_SRC_ROOT)/osprey/common/com \
  -I$(OPEN64_SRC_ROOT)/osprey/common/com/x8664 \
  -I$(OPEN64_SRC_ROOT)/osprey/common/util \
  -I$(OPEN64_SRC_ROOT)/osprey/ipa/common \
  -I$(OPEN64_SRC_ROOT)/osprey/libdwarf/libdwarf \
  -I$(OPEN64_SRC_ROOT)/osprey/include
PYTHON_NATIVE_CXXFLAGS ?= -std=gnu++98 -fPIC
PYTHON_NATIVE_LDFLAGS ?= -shared
OPEN64_DSC_NATIVE_OBJDIR ?=
OPEN64_DSC_NATIVE_LIBCOMUTIL ?=
OPEN64_DSC_NATIVE_LIBJSON ?=
OPEN64_DSC_NATIVE_DEP_INCS ?= \
  -I$(OPEN64_SRC_ROOT)/osprey/include \
  -I$(OPEN64_SRC_ROOT)/osprey/linux/include \
  -I$(OPEN64_SRC_ROOT)/osprey/ipa/common \
  -I$(OPEN64_SRC_ROOT)/osprey/libdwarf/libdwarf
OPEN64_DSC_IR_TOOLS_GCINCS ?= \
  $(OPEN64_DSC_NATIVE_DEP_INCS)
OPEN64_DSC_IR_TOOLS_GCXXINCS ?= \
  $(OPEN64_DSC_IR_TOOLS_GCINCS)
OPEN64_DSC_NATIVE_IR_TOOL_OBJS = \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/config.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/config_elf_targ.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/const.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dsl_builder.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dsl_gatekeeper.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dsl_contract.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dsl_domain.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dsl_ir_image.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dsl_region.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dsl_opcode.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dwarf_DST.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dwarf_DST_dump.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dwarf_DST_mem.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/dwarf_DST_producer.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/glob.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/ir_bcom.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/ir_bwrite.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/irbdata.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/mtypes.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/opcode.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/opcode_core.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/pu_info.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/strtab.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/symtab.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/symtab_verify.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/wn.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/wn_map.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/wn_pragmas.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/wn_simp.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/wn_util.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/wutil.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/xstats.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/intrn_info.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/config_targ.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/targ_const.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/targ_sim.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/config_host.o) \
  $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/config_platform.o)
OPEN64_DSC_NATIVE_OBJS ?= $(strip $(OPEN64_DSC_NATIVE_IR_TOOL_OBJS))
OPEN64_DSC_NATIVE_REQUIRED_FILES ?= $(strip $(OPEN64_DSC_NATIVE_OBJS))
OPEN64_DSC_NATIVE_LDLIBS ?=
OPEN64_IR_B2A ?= $(if $(OPEN64_DSC_NATIVE_OBJDIR),$(OPEN64_DSC_NATIVE_OBJDIR)/ir_b2a)
OPEN64_OPENCC ?=
OPEN64_DSL_TEST_ARTIFACT_DIR ?= $(CURDIR)/test-artifacts
PYTHON_NATIVE_TARGET = $(PYTHON_NATIVE_PACKAGE_DIR)/_whirl$(PYTHON_EXT_SUFFIX)
PYTHON_NATIVE_OBJECTS = \
  _whirl_module.native.o \
  open64_dsc_native_bridge.native.o \
  open64_dsc_native_support.native.o

TARGETS = torch2whirl
LDIRT = $(TARGETS) *.o $(PYTHON_NATIVE_OBJECTS) $(PYTHON_NATIVE_TARGET)

TORCH2WHIRL_CXX_SRCS = \
  torch2whirl.cxx	\
  torch2whirl_driver.cxx

OBJECTS = $(TORCH2WHIRL_CXX_SRCS:.cxx=.o)

.PHONY: default all clean clobber install make_deps python_test \
  driver_native_ir_tools_smoke driver_opencc_smoke driver_torch_test \
  python_torch_test \
  python_native_check python_native_deps python_native_extension \
  python_native_ir_tools_deps python_native_ir_tools_smoke \
  python_native_requirements python_native_stage python_native_test

default: all

all: $(TARGETS)

make_deps: $(TARGETS)

install: $(TARGETS)
	$(MKDIR_P) $(DESTDIR)$(BINDIR)
	$(INSTALL) -m 755 torch2whirl $(DESTDIR)$(BINDIR)/torch2whirl

python_test:
	PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=$(BUILD_BASE)/python \
	    $(PYTHON) -m unittest discover \
	    -s $(BUILD_BASE)/python/tests

python_torch_test:
	PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=$(BUILD_BASE)/python \
	    $(PYTHON) -c 'import torch'
	PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=$(BUILD_BASE)/python \
	    $(PYTHON) -m unittest discover \
	    -s $(BUILD_BASE)/python/tests \
	    -p 'test_*capture_optional.py'

driver_torch_test: $(TARGETS) python_native_stage
	PYTHONDONTWRITEBYTECODE=1 \
	    PYTHONPATH=$(TORCH2WHIRL_PYTHONPATH) \
	    TORCH2WHIRL_DRIVER=$(TORCH2WHIRL_DRIVER) \
	    $(PYTHON) $(BUILD_BASE)/python/tests/driver_torch_smoke.py

driver_native_ir_tools_smoke: $(TARGETS) python_native_extension \
  python_native_ir_tools_deps
	PYTHONDONTWRITEBYTECODE=1 \
	    OPEN64_IR_B2A="$(OPEN64_IR_B2A)" \
	    OPEN64_DSL_TEST_ARTIFACT_DIR="$(OPEN64_DSL_TEST_ARTIFACT_DIR)/driver-native" \
	    PYTHONPATH=$(TORCH2WHIRL_PYTHONPATH) \
	    TORCH2WHIRL_DRIVER=$(TORCH2WHIRL_DRIVER) \
	    $(PYTHON) $(BUILD_BASE)/python/tests/driver_native_ir_tools_smoke.py

driver_opencc_smoke: $(TARGETS)
	@if test -z "$(OPEN64_OPENCC)" && \
	    ! command -v opencc >/dev/null 2>&1; then \
	    echo "skip: opencc not found; set OPEN64_OPENCC to enable smoke test"; \
	else \
	    $(MAKE) python_native_extension && \
	    PYTHONDONTWRITEBYTECODE=1 \
	        OPEN64_OPENCC="$(OPEN64_OPENCC)" \
	        PYTHONPATH=$(TORCH2WHIRL_PYTHONPATH) \
	        TORCH2WHIRL_DRIVER=$(TORCH2WHIRL_DRIVER) \
	        $(PYTHON) $(BUILD_BASE)/python/tests/driver_opencc_smoke.py; \
	fi

python_native_check:
	@if test "`uname -s`" = "Darwin" && \
	    test -z "$(OPEN64_DSC_NATIVE_ALLOW_DARWIN)"; then \
	    echo "skip: native bridge syntax check targets Linux/Open64 headers"; \
	    echo "Set OPEN64_DSC_NATIVE_ALLOW_DARWIN=1 to force a macOS attempt."; \
	else \
	    $(CXX) $(CPPFLAGS) $(PYTHON_NATIVE_CPPFLAGS) \
	        $(PYTHON_NATIVE_CXXFLAGS) -fsyntax-only \
	        $(BUILD_BASE)/python/native/open64_dsc_native_bridge.cxx && \
	    echo "syntax ok: python/native/open64_dsc_native_bridge.cxx"; \
	fi
	@if test -f "$(PYTHON_INCLUDE)/Python.h"; then \
	    $(CXX) $(CPPFLAGS) $(PYTHON_NATIVE_CPPFLAGS) \
	        $(TORCH2WHIRL_CXXFLAGS) -fsyntax-only \
	        $(BUILD_BASE)/python/native/_whirl_module.cxx && \
	    echo "syntax ok: python/native/_whirl_module.cxx"; \
	else \
	    echo "skip: Python.h not found under $(PYTHON_INCLUDE)"; \
	fi

python_native_deps:
	@if test "`uname -s`" = "Darwin" && \
	    test -z "$(OPEN64_DSC_NATIVE_ALLOW_DARWIN)"; then \
	    echo "skip: native dependency build targets Linux/Open64 objects"; \
	    echo "Set OPEN64_DSC_NATIVE_ALLOW_DARWIN=1 to force a macOS attempt."; \
	elif test -z "$(OPEN64_DSC_NATIVE_OBJDIR)" || \
	    test -z "$(OPEN64_DSC_NATIVE_LIBCOMUTIL)"; then \
	    echo "skip: configured native dependency paths are not set"; \
	else \
	    $(MAKE) -C `dirname "$(OPEN64_DSC_NATIVE_LIBCOMUTIL)"` \
	        SKIP_DEP_BUILD=1 \
	        GCINCS="$(OPEN64_DSC_NATIVE_DEP_INCS)" \
	        GC++INCS="$(OPEN64_DSC_NATIVE_DEP_INCS)" && \
	    $(MAKE) -C "$(OPEN64_DSC_NATIVE_OBJDIR)" SKIP_DEP_BUILD=1 \
	        GCINCS="$(OPEN64_DSC_NATIVE_DEP_INCS)" \
	        GC++INCS="$(OPEN64_DSC_NATIVE_DEP_INCS)" \
	        $(notdir $(OPEN64_DSC_NATIVE_OBJS)); \
	fi

python_native_ir_tools_deps:
	@if test "`uname -s`" = "Darwin" && \
	    test -z "$(OPEN64_DSC_NATIVE_ALLOW_DARWIN)"; then \
	    echo "skip: ir_tools dependency build targets Linux/Open64 objects"; \
	    echo "Set OPEN64_DSC_NATIVE_ALLOW_DARWIN=1 to force a macOS attempt."; \
	elif test -z "$(OPEN64_DSC_NATIVE_OBJDIR)" || \
	    test -z "$(OPEN64_DSC_NATIVE_LIBJSON)"; then \
	    echo "skip: configured ir_tools dependency paths are not set"; \
	elif test ! -d `dirname "$(OPEN64_DSC_NATIVE_LIBJSON)"`; then \
	    echo "skip: configured libjson build directory is missing"; \
	else \
	    if test ! -f "$(OPEN64_DSC_NATIVE_LIBJSON)"; then \
	        $(MAKE) -C `dirname "$(OPEN64_DSC_NATIVE_LIBJSON)"`; \
	    fi && \
	    $(MAKE) -C "$(OPEN64_DSC_NATIVE_OBJDIR)" SKIP_DEP_BUILD=1 \
	        GCINCS="$(OPEN64_DSC_IR_TOOLS_GCINCS)" \
	        GC++INCS="$(OPEN64_DSC_IR_TOOLS_GCXXINCS)" \
	        ir_b2a ir_a2b; \
	fi

python_native_requirements:
	@if test ! -f "$(PYTHON_INCLUDE)/Python.h"; then \
	    echo "error: Python.h not found under $(PYTHON_INCLUDE)" >&2; \
	    exit 1; \
	fi
	@if test -z "$(OPEN64_DSC_NATIVE_OBJS)"; then \
	    echo "error: set OPEN64_DSC_NATIVE_OBJS to the Open64 common objects" >&2; \
	    exit 1; \
	fi
	@for file in $(OPEN64_DSC_NATIVE_REQUIRED_FILES); do \
	    if test ! -f "$$file"; then \
	        echo "error: missing native dependency $$file" >&2; \
	        echo "hint: build the Open64 common/ir_tools objects or override OPEN64_DSC_NATIVE_OBJS" >&2; \
	        exit 1; \
	    fi; \
	done

python_native_stage:
	$(MKDIR_P) $(PYTHON_BUILD_ROOT)
	@if test "$(PYTHON_BUILD_ROOT)" != "$(BUILD_BASE)/python"; then \
	    $(RM) -r "$(PYTHON_BUILD_ROOT)/open64_dsc"; \
	    cp -R "$(BUILD_BASE)/python/open64_dsc" "$(PYTHON_BUILD_ROOT)/"; \
	fi

python_native_extension: python_native_deps python_native_requirements \
  python_native_stage
	$(MKDIR_P) $(PYTHON_NATIVE_PACKAGE_DIR)
	$(CXX) $(CPPFLAGS) $(PYTHON_NATIVE_CPPFLAGS) $(CXXFLAGS) \
	    $(TORCH2WHIRL_CXXFLAGS) -fPIC -c -o _whirl_module.native.o \
	    $(BUILD_BASE)/python/native/_whirl_module.cxx
	$(CXX) $(CPPFLAGS) $(PYTHON_NATIVE_CPPFLAGS) $(CXXFLAGS) \
	    $(PYTHON_NATIVE_CXXFLAGS) -c -o open64_dsc_native_bridge.native.o \
	    $(BUILD_BASE)/python/native/open64_dsc_native_bridge.cxx
	$(CXX) $(CPPFLAGS) $(PYTHON_NATIVE_CPPFLAGS) $(CXXFLAGS) \
	    $(PYTHON_NATIVE_CXXFLAGS) -c -o open64_dsc_native_support.native.o \
	    $(BUILD_BASE)/python/native/open64_dsc_native_support.cxx
	$(CXX) $(PYTHON_NATIVE_LDFLAGS) -o $(PYTHON_NATIVE_TARGET) \
	    $(PYTHON_NATIVE_OBJECTS) $(OPEN64_DSC_NATIVE_OBJS) \
	    $(OPEN64_DSC_NATIVE_LDLIBS)

python_native_test: python_native_extension
	PYTHONDONTWRITEBYTECODE=1 \
	    PYTHONPATH=$(PYTHON_BUILD_ROOT):$(BUILD_BASE)/python \
	    $(PYTHON) -m unittest discover \
	    -s $(BUILD_BASE)/python/tests

python_native_ir_tools_smoke: python_native_extension python_native_ir_tools_deps
	PYTHONDONTWRITEBYTECODE=1 \
	    OPEN64_IR_B2A="$(OPEN64_IR_B2A)" \
	    OPEN64_DSL_TEST_ARTIFACT_DIR="$(OPEN64_DSL_TEST_ARTIFACT_DIR)/python-native" \
	    PYTHONPATH=$(PYTHON_BUILD_ROOT):$(BUILD_BASE)/python \
	    $(PYTHON) $(BUILD_BASE)/python/tests/native_ir_tools_smoke.py

clean clobber:
	$(RM) $(LDIRT)

torch2whirl: $(OBJECTS)
	$(CXX) $(CXXFLAGS) $(TORCH2WHIRL_CXXFLAGS) -o $@ $(OBJECTS) \
	    $(LDFLAGS) $(TORCH2WHIRL_LDFLAGS)

%.o: $(BUILD_BASE)/%.cxx $(BUILD_BASE)/torch2whirl_driver.h
	$(CXX) $(CPPFLAGS) $(TORCH2WHIRL_CPPFLAGS) $(CXXFLAGS) \
	    $(TORCH2WHIRL_CXXFLAGS) -c -o $@ $<
